# Frontend (Vercel → Settings → Environment Variables)
# Render backend URL, no trailing slash. Baked in at build time: redeploy after changing it.
VITE_SERVER_URL="https://your-service.onrender.com"

# Backend (Render → Environment). GitHub archive for replays plus a copy of the
# accounts (<REPLAY_GITHUB_DIR>/accounts.json). Without it both live only on the
# server and are lost whenever Render restarts, redeploys or spins down.
REPLAY_GITHUB_TOKEN="github_pat_..."
REPLAY_GITHUB_REPO="msguidie/bridge-replays"
REPLAY_GITHUB_BRANCH="main"
REPLAY_GITHUB_DIR="replays"

# Optional: 0 lets a free Render instance sleep when idle (saves free hours;
# the first visit then waits about a minute while it wakes up).
# KEEP_AWAKE=0
